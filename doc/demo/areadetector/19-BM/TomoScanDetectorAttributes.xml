<?xml version="1.0" standalone="no" ?>
<!-- Attributes -->
<!--
     19-BM-FACT micro-CT.  Loaded by tomoscan_19bm.py into
     19bmVieworks:cam1:NDAttributesFile, with
     19bmVieworks:cam1:NDAttributesMacros = "DET=19bmVieworks:,TC=19bm:TomoScan:"

     Modelled on 7-BM rather than 32-ID: 19-BM is a bending-magnet source, the
     sample stack is a hexapod, and there is no Optique Peter.  Two differences
     from 7-BM are worth knowing:

       * 19-BM has no optics server.  The six optics attributes come from the
         tomoscan IOC's own records via $(TC), exactly as at 7-BM; do not
         repoint them at an MCTOptics prefix copied from 2-BM or 32-ID.

       * S:TopUpStatus, used by 7-BM and 2-BM, no longer exists: APS-U replaced
         top-up with swap-out.  The machine block below uses the APS-U names,
         all verified live from 19-BM on 2026-09-20.

     Every source in this file was checked against the running system on
     2026-09-20.  Attributes for hardware 19-BM does not yet have (the
     hexapod, the SampleTop centering pair, camera motion stages) are
     deliberately absent rather than present and empty.
-->
<Attributes
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://epics.aps.anl.gov/areaDetector/attributes ../attributes.xsd"
    >

    <!-- Detector identity -->
    <Attribute name="DetectorManufacturer"          type="EPICS_PV" source="$(DET)cam1:Manufacturer_RBV"       dbrtype="DBR_STRING"  description="Detector manufacturer"/>
    <Attribute name="DetectorModel"                 type="EPICS_PV" source="$(DET)cam1:Model_RBV"              dbrtype="DBR_STRING"  description="Detector model"/>
    <Attribute name="SerialNumber"                  type="EPICS_PV" source="$(DET)cam1:SerialNumber_RBV"       dbrtype="DBR_STRING"  description="Detector serial number"/>
    <Attribute name="FirmwareVersion"               type="EPICS_PV" source="$(DET)cam1:FirmwareVersion_RBV"    dbrtype="DBR_STRING"  description="Detector firmware version"/>
    <Attribute name="SDKVersion"                    type="EPICS_PV" source="$(DET)cam1:SDKVersion_RBV"         dbrtype="DBR_STRING"  description="Detector vendor SDK version"/>
    <Attribute name="DriverVersion"                 type="EPICS_PV" source="$(DET)cam1:DriverVersion_RBV"      dbrtype="DBR_STRING"  description="areaDetector driver version"/>
    <Attribute name="ADCoreVersion"                 type="EPICS_PV" source="$(DET)cam1:ADCoreVersion_RBV"      dbrtype="DBR_STRING"  description="areaDetector ADCore version"/>

    <!-- Detector readout geometry -->
    <Attribute name="MaxSizeX"                      type="EPICS_PV" source="$(DET)cam1:MaxSizeX_RBV"           dbrtype="DBR_NATIVE"  description="Detector total X pixels"/>
    <Attribute name="MaxSizeY"                      type="EPICS_PV" source="$(DET)cam1:MaxSizeY_RBV"           dbrtype="DBR_NATIVE"  description="Detector total Y pixels"/>
    <Attribute name="ArraySizeX"                    type="EPICS_PV" source="$(DET)cam1:ArraySizeX_RBV"         dbrtype="DBR_LONG"/>
    <Attribute name="ArraySizeY"                    type="EPICS_PV" source="$(DET)cam1:ArraySizeY_RBV"         dbrtype="DBR_LONG"/>
    <Attribute name="MinX"                          type="EPICS_PV" source="$(DET)cam1:MinX_RBV"               dbrtype="DBR_NATIVE"  description="Detector readout min X"/>
    <Attribute name="MinY"                          type="EPICS_PV" source="$(DET)cam1:MinY_RBV"               dbrtype="DBR_NATIVE"  description="Detector readout min Y"/>
    <Attribute name="SizeX"                         type="EPICS_PV" source="$(DET)cam1:SizeX_RBV"              dbrtype="DBR_NATIVE"  description="Detector readout size X"/>
    <Attribute name="SizeY"                         type="EPICS_PV" source="$(DET)cam1:SizeY_RBV"              dbrtype="DBR_NATIVE"  description="Detector readout size Y"/>
    <Attribute name="BinX"                          type="EPICS_PV" source="$(DET)cam1:BinX_RBV"               dbrtype="DBR_NATIVE"  description="Detector readout bin X"/>
    <Attribute name="BinY"                          type="EPICS_PV" source="$(DET)cam1:BinY_RBV"               dbrtype="DBR_NATIVE"  description="Detector readout bin Y"/>

    <!-- Exposure and gain -->
    <Attribute name="AcquireTime"                   type="EPICS_PV" source="$(TC)ExposureTime"                 dbrtype="DBR_NATIVE"  description="Exposure time"/>
    <Attribute name="ExposureAuto"                  type="EPICS_PV" source="$(DET)cam1:ExposureAuto_RBV"       dbrtype="DBR_NATIVE"  description="Exposure auto"/>
    <Attribute name="AcquirePeriod"                 type="EPICS_PV" source="$(DET)cam1:AcquirePeriod_RBV"      dbrtype="DBR_NATIVE"  description="Exposure period"/>
    <Attribute name="FrameRate"                     type="EPICS_PV" source="$(DET)cam1:FrameRate_RBV"          dbrtype="DBR_NATIVE"  description="Frame rate"/>
    <Attribute name="FrameRateEnable"               type="EPICS_PV" source="$(DET)cam1:FrameRateEnable_RBV"    dbrtype="DBR_STRING"  description="Frame rate enable"/>
    <Attribute name="Gain"                          type="EPICS_PV" source="$(DET)cam1:Gain_RBV"               dbrtype="DBR_NATIVE"  description="Gain"/>
    <Attribute name="GainAuto"                      type="EPICS_PV" source="$(DET)cam1:GainAuto_RBV"           dbrtype="DBR_NATIVE"  description="Gain auto"/>
    <Attribute name="DataType"                      type="EPICS_PV" source="$(DET)cam1:DataType_RBV"           dbrtype="DBR_STRING"/>
    <Attribute name="PixelFormat"                   type="EPICS_PV" source="$(DET)cam1:PixelFormat_RBV"        dbrtype="DBR_STRING"  description="Readout pixel format"/>
    <Attribute name="ConvertPixelFormat"            type="EPICS_PV" source="$(DET)cam1:ConvertPixelFormat_RBV" dbrtype="DBR_STRING"  description="Converted pixel format"/>
    <Attribute name="ArrayCounter"                  type="EPICS_PV" source="$(DET)cam1:ArrayCounter_RBV"       dbrtype="DBR_NATIVE"  description="Frames collected to date"/>
    <Attribute name="DetectorTemperature"           type="EPICS_PV" source="$(DET)cam1:TemperatureActual"      dbrtype="DBR_NATIVE"  description="Detector temperature (C)"/>

    <!-- File plugin -->
    <Attribute name="FileName"                      type="EPICS_PV" source="$(DET)HDF1:FileName"               dbrtype="DBR_STRING"  description="File name"/>
    <Attribute name="FullFileName"                  type="EPICS_PV" source="$(DET)HDF1:FullFileName_RBV"       dbrtype="DBR_STRING"  description="Full file name"/>
    <Attribute name="FilePath"                      type="EPICS_PV" source="$(DET)HDF1:FilePath_RBV"           dbrtype="DBR_STRING"  description="File path"/>
    <Attribute name="HDFPluginVersion"              type="EPICS_PV" source="$(DET)HDF1:PluginType_RBV"         dbrtype="DBR_STRING"  description="File plugin type"/>

    <!-- APS machine status.  APS-U names: S:TopUpStatus no longer exists. -->
    <Attribute name="DateTimeStart"                 type="EPICS_PV" source="S:IOC:timeOfDayISO8601"            dbrtype="DBR_STRING"  description="Date and time at start"/>
    <Attribute name="DateTimeEnd"                   type="EPICS_PV" source="S:IOC:timeOfDayISO8601"            dbrtype="DBR_STRING"  description="Date and time at end"/>
    <Attribute name="RingCurrent"                   type="EPICS_PV" source="S-DCCT:CurrentM"                   dbrtype="DBR_NATIVE"  description="Ring current (mA)"/>
    <Attribute name="RingLifetime"                  type="EPICS_PV" source="S-DCCT:LifetimeM"                  dbrtype="DBR_NATIVE"  description="Ring lifetime (min)"/>
    <Attribute name="MachineStatus"                 type="EPICS_PV" source="S:DesiredMode"                     dbrtype="DBR_STRING"  description="Machine status"/>
    <Attribute name="OperatingMode"                 type="EPICS_PV" source="S:ActualMode"                      dbrtype="DBR_STRING"  description="Operating mode"/>
    <Attribute name="InjectionStatus"               type="EPICS_PV" source="S-INJ:InjectionOperationM.VAL"     dbrtype="DBR_STRING"  description="Injection / swap-out operation"/>
    <Attribute name="BeamMode"                      type="EPICS_PV" source="OPS:message3"                      dbrtype="DBR_STRING"  description="Fill pattern"/>
    <Attribute name="BarometricPressure"            type="EPICS_PV" source="APS:BarometricPressure:MBR"        dbrtype="DBR_DOUBLE"  description="Barometric pressure (mbar)"/>

    <!-- Beamline: white-beam slits and filters, 19-BM-A.
         Slit1H/Slit1V are the synApps slit device on 19bmSoft m1-m4.
         The filters are reported as raw stage positions in mm.  When the
         filterbank database is loaded on 19bmSoft these become
         19bmSoft:filter1:Position / filter2:Position, matching 7-BM. -->
    <Attribute name="WB_Slit_H_Size"                type="EPICS_PV" source="19bmSoft:Slit1Hsize"               dbrtype="DBR_DOUBLE"  description="White-beam slit horizontal size (mm)"/>
    <Attribute name="WB_Slit_H_Center"              type="EPICS_PV" source="19bmSoft:Slit1Hcenter"             dbrtype="DBR_DOUBLE"  description="White-beam slit horizontal center (mm)"/>
    <Attribute name="WB_Slit_V_Size"                type="EPICS_PV" source="19bmSoft:Slit1Vsize"               dbrtype="DBR_DOUBLE"  description="White-beam slit vertical size (mm)"/>
    <Attribute name="WB_Slit_V_Center"              type="EPICS_PV" source="19bmSoft:Slit1Vcenter"             dbrtype="DBR_DOUBLE"  description="White-beam slit vertical center (mm)"/>
    <Attribute name="Filter_1_Position"             type="EPICS_PV" source="19bmSoft:m5.RBV"                   dbrtype="DBR_DOUBLE"  description="Filter bank 1 (upstream) position (mm)"/>
    <Attribute name="Filter_2_Position"             type="EPICS_PV" source="19bmSoft:m6.RBV"                   dbrtype="DBR_DOUBLE"  description="Filter bank 2 (downstream) position (mm)"/>

    <!-- Optics.  19-BM has no optics server; these are tomoscan IOC records. -->
    <Attribute name="ScintillatorType"              type="EPICS_PV" source="$(TC)ScintillatorType"             dbrtype="DBR_STRING"  description="Scintillator type"/>
    <Attribute name="ScintillatorThickness"         type="EPICS_PV" source="$(TC)ScintillatorThickness"        dbrtype="DBR_NATIVE"  description="Scintillator thickness (microns)"/>
    <Attribute name="ImagePixelSize"                type="EPICS_PV" source="$(TC)ImagePixelSize"               dbrtype="DBR_NATIVE"  description="Pixel size on sample (microns)"/>
    <Attribute name="DetectorPixelSize"             type="EPICS_PV" source="$(TC)DetectorPixelSize"            dbrtype="DBR_NATIVE"  description="Detector pixel size (microns)"/>
    <Attribute name="CameraObjective"               type="EPICS_PV" source="$(TC)CameraObjective"              dbrtype="DBR_STRING"  description="Objective type"/>
    <Attribute name="CameraTubeLength"              type="EPICS_PV" source="$(TC)CameraTubeLength"             dbrtype="DBR_NATIVE"  description="Tube length (mm)"/>
    <Attribute name="CameraDistance"                type="EPICS_PV" source="$(TC)CameraDistance"               dbrtype="DBR_NATIVE"  description="Sample to detector distance (mm)"/>

    <!-- Energy.  Filtered white beam; the mode record records which. -->
    <Attribute name="Energy"                        type="EPICS_PV" source="$(TC)Energy"                       dbrtype="DBR_NATIVE"  description="Energy (keV)"/>
    <Attribute name="EnergyMode"                    type="EPICS_PV" source="$(TC)EnergyMode"                   dbrtype="DBR_STRING"  description="Energy mode"/>

    <!-- Rotation -->
    <Attribute name="RotationStart"                 type="EPICS_PV" source="$(TC)RotationStart"                dbrtype="DBR_NATIVE"  description="Rotation start position (deg)"/>
    <Attribute name="RotationStep"                  type="EPICS_PV" source="$(TC)RotationStep"                 dbrtype="DBR_NATIVE"  description="Rotation step size (deg)"/>
    <Attribute name="RotationSpeed"                 type="EPICS_PV" source="19bmSoft:aero:m1.VELO"             dbrtype="DBR_NATIVE"  description="Rotation speed (deg/s)"/>
    <Attribute name="SampleRotary"                  type="EPICS_PV" source="19bmSoft:aero:m1.RBV"              dbrtype="DBR_NATIVE"  description="Sample rotation readback (deg)"/>
    <Attribute name="NumAngles"                     type="EPICS_PV" source="$(TC)NumAngles"                    dbrtype="DBR_NATIVE"  description="Number of projections"/>
    <Attribute name="ReturnRotation"                type="EPICS_PV" source="$(TC)ReturnRotation"               dbrtype="DBR_STRING"  description="Return rotation to start after scan"/>

    <!-- Dark fields -->
    <Attribute name="NumDarkFields"                 type="EPICS_PV" source="$(TC)NumDarkFields"                dbrtype="DBR_NATIVE"  description="Number of dark fields"/>
    <Attribute name="DarkFieldMode"                 type="EPICS_PV" source="$(TC)DarkFieldMode"                dbrtype="DBR_STRING"  description="Dark field mode"/>
    <Attribute name="DarkFieldValue"                type="EPICS_PV" source="$(TC)DarkFieldValue"               dbrtype="DBR_NATIVE"  description="Dark field value"/>

    <!-- Flat fields -->
    <Attribute name="NumFlatFields"                 type="EPICS_PV" source="$(TC)NumFlatFields"                dbrtype="DBR_NATIVE"  description="Number of flat fields"/>
    <Attribute name="FlatFieldMode"                 type="EPICS_PV" source="$(TC)FlatFieldMode"                dbrtype="DBR_STRING"  description="Flat field mode"/>
    <Attribute name="FlatFieldValue"                type="EPICS_PV" source="$(TC)FlatFieldValue"               dbrtype="DBR_NATIVE"  description="Flat field value"/>
    <Attribute name="FlatFieldAxis"                 type="EPICS_PV" source="$(TC)FlatFieldAxis"                dbrtype="DBR_STRING"  description="Flat field axis"/>
    <Attribute name="FlatExposureTime"              type="EPICS_PV" source="$(TC)FlatExposureTime"             dbrtype="DBR_NATIVE"  description="Flat field exposure time"/>
    <Attribute name="DifferentFlatExposure"         type="EPICS_PV" source="$(TC)DifferentFlatExposure"        dbrtype="DBR_STRING"  description="Use normal or different flat exposure time"/>
    <Attribute name="SampleOutAngleEnable"          type="EPICS_PV" source="$(TC)SampleOutAngleEnable"         dbrtype="DBR_STRING"  description="Enable sample out at a specific angle"/>
    <Attribute name="SampleOutAngle"                type="EPICS_PV" source="$(TC)SampleOutAngle"               dbrtype="DBR_STRING"  description="Angle where the flat field is taken"/>

    <!-- Sample in/out positions.  These are the tomoscan setpoints; the motor
         readbacks are not recorded because the hexapod that drives them is
         still to be moved here from 7-BM and has no prefix yet. -->
    <Attribute name="SampleInX"                     type="EPICS_PV" source="$(TC)SampleInX"                    dbrtype="DBR_NATIVE"  description="Sample in X position (mm)"/>
    <Attribute name="SampleOutX"                    type="EPICS_PV" source="$(TC)SampleOutX"                   dbrtype="DBR_NATIVE"  description="Sample out X position (mm)"/>
    <Attribute name="SampleInY"                     type="EPICS_PV" source="$(TC)SampleInY"                    dbrtype="DBR_NATIVE"  description="Sample in Y position (mm)"/>
    <Attribute name="SampleOutY"                    type="EPICS_PV" source="$(TC)SampleOutY"                   dbrtype="DBR_NATIVE"  description="Sample out Y position (mm)"/>

    <!-- Sample description -->
    <Attribute name="SampleName"                    type="EPICS_PV" source="$(TC)SampleName"                   dbrtype="DBR_STRING"  description="Sample name"/>
    <Attribute name="SampleDescription1"            type="EPICS_PV" source="$(TC)SampleDescription1"           dbrtype="DBR_STRING"  description="Sample description 1"/>
    <Attribute name="SampleDescription2"            type="EPICS_PV" source="$(TC)SampleDescription2"           dbrtype="DBR_STRING"  description="Sample description 2"/>
    <Attribute name="SampleDescription3"            type="EPICS_PV" source="$(TC)SampleDescription3"           dbrtype="DBR_STRING"  description="Sample description 3"/>

    <!-- User and proposal -->
    <Attribute name="UserLastName"                  type="EPICS_PV" source="$(TC)UserLastName"                 dbrtype="DBR_STRING"  description="User last name"/>
    <Attribute name="UserInstitution"               type="EPICS_PV" source="$(TC)UserInstitution"              dbrtype="DBR_STRING"  description="User institution"/>
    <Attribute name="UserBadge"                     type="EPICS_PV" source="$(TC)UserBadge"                    dbrtype="DBR_STRING"  description="User badge number"/>
    <Attribute name="UserEmail"                     type="EPICS_PV" source="$(TC)UserEmail"                    dbrtype="DBR_STRING"  description="User e-mail"/>
    <Attribute name="ProposalNumber"                type="EPICS_PV" source="$(TC)ProposalNumber"               dbrtype="DBR_STRING"  description="Proposal number"/>
    <Attribute name="ProposalTitle"                 type="EPICS_PV" source="$(TC)ProposalTitle"                dbrtype="DBR_STRING"  description="Proposal title"/>
    <Attribute name="ESAFNumber"                    type="EPICS_PV" source="$(TC)ESAFNumber"                   dbrtype="DBR_STRING"  description="ESAF number"/>

    <!-- Scan type -->
    <Attribute name="ScanType"                      type="EPICS_PV" source="$(TC)ScanType"                     dbrtype="DBR_STRING"  description="Scan type"/>
    <Attribute name="ScanUUID"                      type="EPICS_PV" source="$(TC)ScanUUID"                     dbrtype="DBR_STRING"  description="Scan UUID"/>
    <Attribute name="FlipStitch"                    type="EPICS_PV" source="$(TC)FlipStitch"                   dbrtype="DBR_STRING"  description="Flip and stitch"/>

    <!-- Frame routing.  This drives detector_data_destination in the layout
         file, sending each frame to /exchange/data, data_dark or data_white.
         Without it every frame lands in one dataset. -->
    <Attribute name="HDF5FrameLocation"             type="EPICS_PV" source="$(TC)HDF5Location"                 dbrtype="DBR_STRING"  description="Where to store frame in the HDF5 file"/>

</Attributes>
