<?xml version="1.0" standalone="no" ?>
<!-- Attributes -->
<Attributes
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://epics.aps.anl.gov/areaDetector/attributes ../attributes.xsd"
    >

    <Attribute name="DateTimeStart"                 type="EPICS_PV" source="S:IOC:timeOfDayISO8601"                        dbrtype="DBR_STRING"/>
    <Attribute name="DateTimeEnd"                   type="EPICS_PV" source="S:IOC:timeOfDayISO8601"                        dbrtype="DBR_STRING"/>
    <Attribute name="RingCurrent"                   type="EPICS_PV" source="S-DCCT:CurrentM"                               dbrtype="DBR_DOUBLE"/>
    <Attribute name="RingLifetime"                  type="EPICS_PV" source="S-DCCT:LifetimeM"                              dbrtype="DBR_NATIVE"/>
    <Attribute name="MachineStatus"                 type="EPICS_PV" source="S:DesiredMode"                                 dbrtype="DBR_STRING"/>
    <Attribute name="OperatingMode"                 type="EPICS_PV" source="S:ActualMode"                                  dbrtype="DBR_STRING"/>
    <Attribute name="InjectionStatus"               type="EPICS_PV" source="S-INJ:InjectionOperationM.VAL"                 dbrtype="DBR_STRING"/>
    <Attribute name="BeamMode"                      type="EPICS_PV" source="OPS:message3"                                  dbrtype="DBR_STRING"/>

    <Attribute name="SourceEnergy"                  type="EPICS_PV" source="S32ID:USID:EnergyM.VAL"                        dbrtype="DBR_DOUBLE"/>
    <Attribute name="SourceGap"                     type="EPICS_PV" source="S32ID:USID:GapM.VAL"                           dbrtype="DBR_DOUBLE"/>
    <Attribute name="Energy"                        type="EPICS_PV" source="32ida:BraggEAO.VAL"                            dbrtype="DBR_DOUBLE"/>

    <Attribute name="HSlitsSize"                    type="EPICS_PV" source="32idb:Slit1Hsize.VAL"                          dbrtype="DBR_DOUBLE"/>
    <Attribute name="HSlitsCenter"                  type="EPICS_PV" source="32idb:Slit1Hcenter.VAL"                        dbrtype="DBR_DOUBLE"/>
    <Attribute name="VSlitsSize"                    type="EPICS_PV" source="32idb:Slit1Vsize.VAL"                          dbrtype="DBR_DOUBLE"/>
    <Attribute name="VSlitsCenter"                  type="EPICS_PV" source="32idb:Slit1Vcenter.VAL"                        dbrtype="DBR_DOUBLE"/>

    <Attribute name="DCMTheta"                      type="EPICS_PV" source="32ida:m1.VAL"                                  dbrtype="DBR_DOUBLE"/>
    <Attribute name="DCMTheta2"                     type="EPICS_PV" source="32ida:m2.VAL"                                  dbrtype="DBR_DOUBLE"/>
    <Attribute name="DCMChi2"                       type="EPICS_PV" source="32ida:m3.VAL"                                  dbrtype="DBR_DOUBLE"/>
    <Attribute name="DCMX"                          type="EPICS_PV" source="32ida:m4.VAL"                                  dbrtype="DBR_DOUBLE"/>
    <Attribute name="DCMY"                          type="EPICS_PV" source="32ida:m5.VAL"                                  dbrtype="DBR_DOUBLE"/>
    <Attribute name="DCMX2"                         type="EPICS_PV" source="32ida:m6.VAL"                                  dbrtype="DBR_DOUBLE"/>
    <Attribute name="DCMY1"                         type="EPICS_PV" source="32ida:m7.VAL"                                  dbrtype="DBR_DOUBLE"/>
    <Attribute name="DCMZ2"                         type="EPICS_PV" source="32ida:m8.VAL"                                  dbrtype="DBR_DOUBLE"/>
    <Attribute name="DCMFlag"                       type="EPICS_PV" source="32idb:m5.VAL"                                  dbrtype="DBR_DOUBLE"/>

    <Attribute name="SampleX"                       type="EPICS_PV" source="32idc02:m39.RBV"                               dbrtype="DBR_DOUBLE" description="Tomo_X sample translation (mm)"/>
    <Attribute name="SampleY"                       type="EPICS_PV" source="32idc02:m23.RBV"                               dbrtype="DBR_DOUBLE" description="Tomo_Y sample translation (mm)"/>
    <Attribute name="SamplePitch"                   type="EPICS_PV" source="32idc02:m38.RBV"                               dbrtype="DBR_DOUBLE" description="Tomo_Pitch sample alignment"/>
    <Attribute name="SampleRoll"                    type="EPICS_PV" source="32idc02:m37.RBV"                               dbrtype="DBR_DOUBLE" description="Tomo_Roll sample roll (deg)"/>
    <Attribute name="SampleRotary"                  type="EPICS_PV" source="32idcSoft:ens:c1:m1.RBV"                       dbrtype="DBR_DOUBLE" description="Sample rotation (deg)"/>
    <Attribute name="RotationSpeed"                 type="EPICS_PV" source="32idcSoft:ens:c1:m1.VELO"                      dbrtype="DBR_DOUBLE" description="Rotation speed (deg/s)"/>

    <Attribute name="CcdCameraY"                    type="EPICS_PV" source="32idc02:m16.RBV"                               dbrtype="DBR_DOUBLE"/>

    <Attribute name="DetectorManufacturer"          type="EPICS_PV" source="$(DET)cam1:Manufacturer_RBV"                   dbrtype="DBR_STRING"/>
    <Attribute name="DetectorModel"                 type="EPICS_PV" source="$(DET)cam1:Model_RBV"                          dbrtype="DBR_STRING"/>
    <Attribute name="SerialNumber"                  type="EPICS_PV" source="$(DET)cam1:SerialNumber_RBV"                   dbrtype="DBR_STRING"/>
    <Attribute name="FirmwareVersion"               type="EPICS_PV" source="$(DET)cam1:FirmwareVersion_RBV"                dbrtype="DBR_STRING"/>
    <Attribute name="SDKVersion"                    type="EPICS_PV" source="$(DET)cam1:SDKVersion_RBV"                     dbrtype="DBR_STRING"/>
    <Attribute name="DriverVersion"                 type="EPICS_PV" source="$(DET)cam1:DriverVersion_RBV"                  dbrtype="DBR_STRING"/>
    <Attribute name="ADCoreVersion"                 type="EPICS_PV" source="$(DET)cam1:ADCoreVersion_RBV"                  dbrtype="DBR_STRING"/>

    <Attribute name="MaxSizeX"                      type="EPICS_PV" source="$(DET)cam1:MaxSizeX_RBV"                       dbrtype="DBR_LONG"/>
    <Attribute name="MaxSizeY"                      type="EPICS_PV" source="$(DET)cam1:MaxSizeY_RBV"                       dbrtype="DBR_LONG"/>
    <Attribute name="ArraySizeX"                    type="EPICS_PV" source="$(DET)cam1:ArraySizeX_RBV"                     dbrtype="DBR_LONG"/>
    <Attribute name="ArraySizeY"                    type="EPICS_PV" source="$(DET)cam1:ArraySizeY_RBV"                     dbrtype="DBR_LONG"/>
    <Attribute name="MinX"                          type="EPICS_PV" source="$(DET)cam1:MinX_RBV"                           dbrtype="DBR_LONG"/>
    <Attribute name="MinY"                          type="EPICS_PV" source="$(DET)cam1:MinY_RBV"                           dbrtype="DBR_LONG"/>
    <Attribute name="SizeX"                         type="EPICS_PV" source="$(DET)cam1:SizeX_RBV"                          dbrtype="DBR_LONG"/>
    <Attribute name="SizeY"                         type="EPICS_PV" source="$(DET)cam1:SizeY_RBV"                          dbrtype="DBR_LONG"/>
    <Attribute name="BinX"                          type="EPICS_PV" source="$(DET)cam1:BinX_RBV"                           dbrtype="DBR_LONG"/>
    <Attribute name="BinY"                          type="EPICS_PV" source="$(DET)cam1:BinY_RBV"                           dbrtype="DBR_LONG"/>

    <Attribute name="AcquireTime"                   type="EPICS_PV" source="$(DET)cam1:AcquireTime_RBV"                    dbrtype="DBR_DOUBLE"/>
    <Attribute name="ExposureAuto"                  type="EPICS_PV" source="$(DET)cam1:ExposureAuto_RBV"                   dbrtype="DBR_NATIVE" description="Exposure auto"/>
    <Attribute name="AcquirePeriod"                 type="EPICS_PV" source="$(DET)cam1:AcquirePeriod_RBV"                  dbrtype="DBR_DOUBLE"/>
    <Attribute name="FrameRate"                     type="EPICS_PV" source="$(DET)cam1:FrameRate_RBV"                      dbrtype="DBR_DOUBLE"/>
    <Attribute name="FrameRateEnable"               type="EPICS_PV" source="$(DET)cam1:FrameRateEnable_RBV"                dbrtype="DBR_ENUM"/>
    <Attribute name="Gain"                          type="EPICS_PV" source="$(DET)cam1:Gain_RBV"                           dbrtype="DBR_DOUBLE"/>
    <Attribute name="GainAuto"                      type="EPICS_PV" source="$(DET)cam1:GainAuto_RBV"                       dbrtype="DBR_NATIVE" description="Gain auto"/>
    <Attribute name="DataType"                      type="EPICS_PV" source="$(DET)cam1:DataType_RBV"                       dbrtype="DBR_STRING"/>
    <Attribute name="PixelFormat"                   type="EPICS_PV" source="$(DET)cam1:PixelFormat_RBV"                    dbrtype="DBR_STRING" description="Readout pixel format"/>
    <Attribute name="ConvertPixelFormat"            type="EPICS_PV" source="$(DET)cam1:ConvertPixelFormat_RBV"             dbrtype="DBR_STRING" description="Converted pixel format"/>
    <Attribute name="ArrayCounter"                  type="EPICS_PV" source="$(DET)cam1:ArrayCounter_RBV"                   dbrtype="DBR_LONG"/>
    <Attribute name="DetectorTemperature"           type="EPICS_PV" source="$(DET)cam1:TemperatureActual"                  dbrtype="DBR_DOUBLE"/>

    <Attribute name="FileName"                      type="EPICS_PV" source="$(DET)HDF1:FileName"                           dbrtype="DBR_STRING" description="File name "/>
    <Attribute name="FilePath"                      type="EPICS_PV" source="$(DET)HDF1:FilePath_RBV"                       dbrtype="DBR_STRING"/>
    <Attribute name="FullFileName"                  type="EPICS_PV" source="$(DET)HDF1:FullFileName_RBV"                   dbrtype="DBR_STRING"/>
    <Attribute name="HDFPlugInVersion"              type="EPICS_PV" source="$(DET)HDF1:PluginType_RBV"                     dbrtype="DBR_STRING"/>

    <Attribute name="ScintillatorType"              type="EPICS_PV" source="32id:MCTOptics:ScintillatorType"               dbrtype="DBR_STRING" description="Scintillator type"/>
    <Attribute name="ScintillatorThickness"         type="EPICS_PV" source="32id:MCTOptics:ScintillatorThickness"          dbrtype="DBR_NATIVE" description="Scintillator thickness (microns)"/>
    <Attribute name="ImagePixelSize"                type="EPICS_PV" source="32id:MCTOptics:ImagePixelSize"                 dbrtype="DBR_NATIVE" description="Pixel size on sample (microns)"/>
    <Attribute name="DetectorPixelSize"             type="EPICS_PV" source="32id:MCTOptics:DetectorPixelSize"              dbrtype="DBR_NATIVE" description="Detector pixel size (microns)"/>
    <Attribute name="CameraObjective"               type="EPICS_PV" source="32id:MCTOptics:CameraObjective"                dbrtype="DBR_STRING" description="Objective Magnification"/>
    <Attribute name="CameraTubeLength"              type="EPICS_PV" source="32id:MCTOptics:CameraTubeLength"               dbrtype="DBR_NATIVE" description="Tube length (mm)"/>
    
    <Attribute name="RotationStart"                 type="EPICS_PV" source="$(TS)RotationStart"                            dbrtype="DBR_NATIVE" description="Rotation start position (deg)"/>
    <Attribute name="RotationStep"                  type="EPICS_PV" source="$(TS)RotationStep"                             dbrtype="DBR_NATIVE" description="Rotation step size (deg)"/>
    <Attribute name="NumAngles"                     type="EPICS_PV" source="$(TS)NumAngles"                                dbrtype="DBR_NATIVE" description="Number of projections"/>
    <Attribute name="ReturnRotation"                type="EPICS_PV" source="$(TS)ReturnRotation"                           dbrtype="DBR_STRING" description="Return rotation to start after scan"/>
    <Attribute name="NumDarkFields"                 type="EPICS_PV" source="$(TS)NumDarkFields"                            dbrtype="DBR_NATIVE" description="Number of dark fields"/>
    <Attribute name="DarkFieldMode"                 type="EPICS_PV" source="$(TS)DarkFieldMode"                            dbrtype="DBR_STRING" description="Dark field mode"/>
    <Attribute name="DarkFieldValue"                type="EPICS_PV" source="$(TS)DarkFieldValue"                           dbrtype="DBR_NATIVE" description="Dark field value"/>
    <Attribute name="NumFlatFields"                 type="EPICS_PV" source="$(TS)NumFlatFields"                            dbrtype="DBR_NATIVE" description="Number of flat fields"/>
    <Attribute name="FlatFieldMode"                 type="EPICS_PV" source="$(TS)FlatFieldMode"                            dbrtype="DBR_STRING" description="Flat field mode"/>
    <Attribute name="FlatFieldValue"                type="EPICS_PV" source="$(TS)FlatFieldValue"                           dbrtype="DBR_NATIVE" description="Flat field value"/>
    <Attribute name="FlatFieldAxis"                 type="EPICS_PV" source="$(TS)FlatFieldAxis"                            dbrtype="DBR_STRING" description="Flat field axis"/>
    <Attribute name="FlatExposureTime"              type="EPICS_PV" source="$(TS)FlatExposureTime"                         dbrtype="DBR_NATIVE" description="Flat field exposure time"/>
    <Attribute name="DifferentFlatExposure"         type="EPICS_PV" source="$(TS)DifferentFlatExposure"                    dbrtype="DBR_STRING" description="Use normal or different flat exposure time"/>
    <Attribute name="SampleOutAngleEnable"          type="EPICS_PV" source="$(TS)SampleOutAngleEnable"                     dbrtype="DBR_STRING" description="Enable sample out at a specific angle"/>
    <Attribute name="SampleOutAngle"                type="EPICS_PV" source="$(TS)SampleOutAngle"                           dbrtype="DBR_STRING" description="Angle where to take the flat field"/>
    <Attribute name="SampleInX"                     type="EPICS_PV" source="$(TS)SampleInX"                                dbrtype="DBR_NATIVE" description="Sample in X position (mm)"/>
    <Attribute name="SampleOutX"                    type="EPICS_PV" source="$(TS)SampleOutX"                               dbrtype="DBR_NATIVE" description="Sample out X position (mm)"/>
    <Attribute name="SampleInY"                     type="EPICS_PV" source="$(TS)SampleInY"                                dbrtype="DBR_NATIVE" description="Sample in Y position (mm)"/>
    <Attribute name="SampleOutY"                    type="EPICS_PV" source="$(TS)SampleOutY"                               dbrtype="DBR_NATIVE" description="Sample out Y position (mm)"/>
    <Attribute name="SampleName"                    type="EPICS_PV" source="$(TS)SampleName"                               dbrtype="DBR_STRING" description="Sample name"/>
    <Attribute name="SampleDescription1"            type="EPICS_PV" source="$(TS)SampleDescription1"                       dbrtype="DBR_STRING" description="Sample description 1"/>
    <Attribute name="SampleDescription2"            type="EPICS_PV" source="$(TS)SampleDescription2"                       dbrtype="DBR_STRING" description="Sample description 2"/>
    <Attribute name="SampleDescription3"            type="EPICS_PV" source="$(TS)SampleDescription3"                       dbrtype="DBR_STRING" description="Sample description 3"/>
    <Attribute name="UserLastName"                  type="EPICS_PV" source="$(TS)UserLastName"                             dbrtype="DBR_STRING" description="User last name"/>
    <Attribute name="UserInstitution"               type="EPICS_PV" source="$(TS)UserInstitution"                          dbrtype="DBR_STRING" description="User institution"/>
    <Attribute name="UserBadge"                     type="EPICS_PV" source="$(TS)UserBadge"                                dbrtype="DBR_STRING" description="User badge number"/>
    <Attribute name="UserEmail"                     type="EPICS_PV" source="$(TS)UserEmail"                                dbrtype="DBR_STRING" description="User e-mail"/>
    <Attribute name="ProposalNumber"                type="EPICS_PV" source="$(TS)ProposalNumber"                           dbrtype="DBR_STRING" description="Proposal number"/>
    <Attribute name="ProposalTitle"                 type="EPICS_PV" source="$(TS)ProposalTitle"                            dbrtype="DBR_STRING" description="Proposal title"/>
    <Attribute name="ESAFNumber"                    type="EPICS_PV" source="$(TS)ESAFNumber"                               dbrtype="DBR_STRING" description="ESAF number"/>
    <Attribute name="HDF5FrameLocation"             type="EPICS_PV" source="$(TS)HDF5Location"                             dbrtype="DBR_STRING" description="Where to store frame in HDF5 file"/>

    <Attribute name="ScanType"                      type="EPICS_PV" source="$(TS)ScanType"                                 dbrtype="DBR_STRING" description="Scan type"/>
    <Attribute name="FlipStitch"                    type="EPICS_PV" source="$(TS)FlipStitch"                               dbrtype="DBR_STRING" description="Flip and stitch"/>

 <!--   <Attribute name="Theta"             type="EPICS_PV" source="32idcTXM:hydra:c0:m1.VAL"     dbrtype="DBR_DOUBLE"/> -->

</Attributes>

